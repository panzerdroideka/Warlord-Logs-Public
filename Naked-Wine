# =========================================================
# Wils Naked-Wine Launch Parameters for LotRO
# =========================================================
# Philosophy: Absolute System Autonomy (The Edison Way)
# This configuration is strictly built to guarantee only ONE 
# wine window and flawless MangoHud telemetry injection.

# 1. Performance and Synchronization
export WINEFSYNC=1
export WINEESYNC=1

# 2. Scaling and FSR
export WINE_FULLSCREEN_FSR=1
export WINE_FULLSCREEN_FSR_Strength=1

# 3. MangoHud Configuration Path
export MANGOHUD_CONFIGFILE=/mangohud/mangohud.conf

# 4. The Runis Skill-Queue Engine Launch
# Navigating directly to the game directory
cd /home/Wils/games/warlord/spillfiler/

# Bypassing external launchers to force a single client window
mangohud wine lotroclient64.exe -skiprawdownload -nosplash
